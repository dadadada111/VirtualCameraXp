<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="虚拟摄像头配置"
            android:textSize="24sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="20dp"/>

        <!-- 全局配置区域 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="全局配置 (默认)"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginTop="10dp"/>

        <EditText
            android:id="@+id/et_global_url"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="输入 HTTP/RTSP 地址"
            android:inputType="textUri"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            
            <Button
                android:id="@+id/btn_global_select_video"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="选择本地视频"/>
                
            <TextView
                android:id="@+id/tv_global_video_path"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="未选择"
                android:layout_gravity="center_vertical"
                android:paddingStart="8dp"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="end">
            
            <Button
                android:id="@+id/btn_global_clear"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="清除配置"
                android:backgroundTint="#FF5252"
                android:layout_marginEnd="8dp"/>

            <Button
                android:id="@+id/btn_global_save"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="保存全局配置"/>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#CCCCCC"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="20dp"/>

        <!-- 特定应用配置区域 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="特定应用配置"
            android:textSize="18sp"
            android:textStyle="bold"/>
            
        <EditText
            android:id="@+id/et_app_package"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="输入目标应用包名 (如 com.ss.android.ugc.aweme)"
            android:inputType="text"/>

        <EditText
            android:id="@+id/et_app_url"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="输入 HTTP/RTSP 地址"
            android:inputType="textUri"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_app_select_video"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="选择本地视频"/>

            <TextView
                android:id="@+id/tv_app_video_path"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="未选择"
                android:layout_gravity="center_vertical"
                android:paddingStart="8dp"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="end">

            <Button
                android:id="@+id/btn_app_clear"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="清除配置"
                android:backgroundTint="#FF5252"
                android:layout_marginEnd="8dp"/>

            <Button
                android:id="@+id/btn_app_save"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="保存应用配置"/>
        </LinearLayout>
        
        <TextView
            android:id="@+id/tv_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="状态: 就绪"
            android:layout_marginTop="20dp"
            android:textColor="#009688"/>

    </LinearLayout>
</ScrollView>
